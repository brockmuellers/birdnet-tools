# Copy to .env and fill in real values. Never commit .env.
BIRDNETPI_DB_PATH=<path_to_birdnetpi>/scripts/birds.db

# Backup settings (run_backup.sh)
BACKUP_DEST=/mnt/usb/birdnet-backup
# BACKUP_DB_RETAIN_DAYS=7   # days of nightly DB backups to keep (default: 7)
# BACKUP_DISK_WARN_PCT=80   # warn in backup.log when disk is this % full (default: 80)
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=birdnet-data
R2_OBJECT_KEY=birdnet-data.json
# EXPORT_OUTPUT_PATH=/tmp/birdnet_export.json  # optional, this is the default

# DB R2 backup settings (backup_db_r2.py)
R2_DB_BACKUP_MAX_MB=500        # required; backup aborts with error if DB exceeds this (note: ~2-3x RAM needed on upload)
# R2_DB_BACKUP_OBJECT_KEY=birds.db  # optional, this is the default

# Event log settings (sample_metrics.py, push_events.py)
# TEMP_WARN_C=70                         # log WARN if chip temp exceeds this (default: 70°C)
# MEMORY_WARN_MB=100                     # log WARN if available memory falls below this (default: 100 MB)
# EVENT_LOG_RETAIN_DAYS=7              # days of events to keep locally and upload (default: 7)
# EVENT_LOG_OBJECT_KEY=birdnet-events.json  # optional, this is the default
# UPLOAD_STALE_WARN_MIN=29             # log WARN if push_events hasn't uploaded successfully in this many minutes (default: 29)
